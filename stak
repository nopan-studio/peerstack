#!/usr/bin/env bash
set -euo pipefail

if [ -n "${PEERSTACK_ROOT:-}" ]; then
  ROOT="$PEERSTACK_ROOT"
else
  SCRIPT_SOURCE="${BASH_SOURCE[0]}"
  while [ -L "$SCRIPT_SOURCE" ]; do
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
    SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
    [[ $SCRIPT_SOURCE != /* ]] && SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE"
  done
  ROOT="$(cd "$(dirname "$SCRIPT_SOURCE")" && pwd)"
fi

case "${1:-}" in
  hub)
    shift
    exec bun "$ROOT/hub/server.ts" "$@"
    ;;
  spawn)
    shift
    exec bun "$ROOT/scripts/spawn.ts" "$@"
    ;;
  team)
    shift
    exec bun "$ROOT/scripts/tmux-start.ts" "$@"
    ;;
  list)
    shift
    echo "Available agents:"
    for f in "$ROOT"/agents/*.md; do
      name=$(grep -m1 '^name:' "$f" 2>/dev/null | sed 's/name: *//; s/"//g' || basename "$f" .md)
      desc=$(grep -m1 '^description:' "$f" 2>/dev/null | sed 's/description: *//; s/"//g' || "")
      model=$(grep -m1 '^model:' "$f" 2>/dev/null | sed 's/model: *//; s/"//g' || "")
      printf "  %-15s %-30s %s\n" "$name" "$model" "$desc"
    done
    ;;
  *)
    echo "peerstack — Pi-to-Pi agent mesh"
    echo ""
    echo "Usage:"
    echo "  peerstack hub                          Start the hub (live dashboard)"
    echo "  peerstack spawn <name> [project-dir]   Spawn an agent from agents/<name>.md"
    echo "  peerstack team [project-dir]           Spawn all agents in current tmux window panes"
    echo "  peerstack list                         List available agents"
    echo ""
    echo "Spawn options:"
    echo "  --model <model>     Override agent model"
    echo "  --tools <tools>     Override tool allowlist"
    echo "  --project <dir>     Set working directory for the agent"
    echo ""
    echo "Examples:"
    echo "  peerstack hub"
    echo "  peerstack spawn dax"
    echo "  peerstack spawn dax ./my-project"
    echo "  peerstack team ./my-project"
    echo "  peerstack spawn dax --model google/gemini-3-flash-preview"
    exit 1
    ;;
esac
