# ─────────────────────────────────────────────
#  peerstack — Pi-to-Pi Agent Mesh
#  Copy to .env and fill in your API keys
#  Usage: source .env && pstack hub
# ─────────────────────────────────────────────

# You need at least one provider key for your agents.
# Agents will use whatever model you specify in their .md frontmatter.

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini
GEMINI_API_KEY=AIza...

# OpenRouter
OPENROUTER_API_KEY=sk-or-...

# ─────────────────────────────────────────────
#  Hub config
# ─────────────────────────────────────────────

# Set a fixed auth token for LAN/remote access.
# Leave blank for localhost-only (auto-generates on first run).
PEERSTACK_AUTH_TOKEN=

# Pin the hub port. Leave blank (or 0) for OS-assigned.
PEERSTACK_PORT=
